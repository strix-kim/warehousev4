{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.79",
        "--caps",
        "pdf",
        "--user-data-dir",
        ".playwright-profile",
        "--output-dir",
        ".playwright-out"
      ]
    },
    "motion": {
      "type": "http",
      "url": "https://mcp.motion.dev"
    }
  }
}
